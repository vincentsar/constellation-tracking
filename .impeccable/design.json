{
  "name": "Constellation tracker",
  "colors": {
    "primary": "#365c4c",
    "background": "#f7f5ef",
    "paper": "#fffefa",
    "foreground": "#263a37",
    "secondary": "#586b62",
    "border": "#d2d8ce"
  },
  "typography": {
    "body": {
      "fontFamily": "Inter, sans-serif",
